DB_URL=jdbc:postgresql://{db_host}:{db_port}/{db_name}
DB_USERNAME={your_username_here}
DB_PASSWORD={your_password_here}

JPA_DDL_AUTO=validate
# application.yml 기본값이 false이므로 배포 환경에서는 반드시 true로 명시한다.
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=true

JWT_SECRET={your_jwt_secret_here}
JWT_ACCESS_EXPIRE_MS=86400001
JWT_REFRESH_EXPIRE_MS=259200000

SERVER_BASE_URL=http://localhost
SERVER_PORT=8080

# Gmail SMTP. 계정 비밀번호가 아니라 2단계 인증 후 발급한 앱 비밀번호를 사용한다.
MAIL_USERNAME={your_gmail_address}
MAIL_PASSWORD={gmail_app_password}
MAIL_FROM_ADDRESS={your_gmail_address}

EXTERNAL_REST_CLIENT_CONNECT_TIMEOUT_MS=3000
EXTERNAL_REST_CLIENT_READ_TIMEOUT_MS=5000

PROFIT_FUNCTION_ENDPOINT={profit_function_endpoint}
PROFIT_FUNCTION_API_KEY={profit_function_api_key}
SURVIVAL_FUNCTION_ENDPOINT={survival_function_endpoint}
SURVIVAL_FUNCTION_API_KEY={survival_function_api_key}

SWAGGER_ENABLED=true
ACTUATOR_EXPOSURE=health,prometheus

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,PUT,POST,PATCH,DELETE,OPTIONS

SEOUL_OPEN_API_KEY=your-seoul-open-api-key
SMALL_BUSINESS_STORE_API_KEY=your-data-go-kr-service-key
KOSIS_API_KEY=your-kosis-open-api-key

# 뉴스 배치는 마이그레이션·수동 수집 검증 후 활성화한다.
NEWS_BATCH_ENABLED=false
NEWS_RUN_ONCE=
# 조회 집계에 필요한 별도 HMAC 비밀키. 모든 인스턴스에 동일한 32자 이상의 값을 설정한다.
NEWS_VIEWER_SECRET=
# HTTPS 배포는 true. localhost HTTP 개발 환경만 false로 설정한다.
NEWS_VIEWER_COOKIE_SECURE=true
